{
  "expo": {
    "scheme": "myapp",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@prisma/react-native"
    ],
    "name": "expo-auth-demo",
    "slug": "expo-auth-demo",
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    }
  }
}